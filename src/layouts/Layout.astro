---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Cartas de Mesa" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1c1425" />
    <meta
      name="description"
      content="Juego de cartas para el celular, tipo HDP o Amigos de Mierda, sin necesidad de servidores: compartí un código y repartí las cartas."
    />
    <title>{title}</title>
  </head>
  <body class="bg-ink text-paper font-body antialiased">
    <div class="mx-auto flex min-h-dvh w-full max-w-md flex-col px-5 pb-[env(safe-area-inset-bottom)] pt-[env(safe-area-inset-top)]">
      <slot />
    </div>
  </body>
</html>
