  let usados = new Set<number>();

  function siguiente() {
    if (usados.size >= NOMBRES.length) usados.clear();

    let idx: number;
    do {
      idx = Math.floor(Math.random() * NOMBRES.length);
    } while (usados.has(idx));

    usados.add(idx);
    nombreEl.textContent = NOMBRES[idx];
  }

  btnSiguiente.addEventListener("click", siguiente);
  // Primer nombre al cargar
  siguiente();
