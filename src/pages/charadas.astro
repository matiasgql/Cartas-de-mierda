---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Charadas — Cartas de Mesa">
  <main class="relative flex flex-1 flex-col py-6">
    <div class="flex items-center justify-between text-sm text-mist">
      <a href={import.meta.env.BASE_URL} id="link-salir">Salir</a>
      <span class="font-display font-bold text-paper">Charadas</span>
      <span class="w-10"></span>
    </div>

    <div
      id="pantalla"
      class="flex flex-1 flex-col items-center justify-center gap-6"
    >
      <p class="text-center text-sm text-mist">
        Pasá el celu a quien actúa. El resto adivina en persona.
      </p>

      <div
        id="nombre-box"
        class="flex min-h-40 w-full items-center justify-center px-4"
      >
        <p
          id="nombre"
          class="font-display text-center text-4xl font-black leading-tight text-paper sm:text-5xl"
          style="writing-mode: horizontal-tb;"
        >
        </p>
      </div>

      <p id="pista" class="text-center text-xs text-mist/70">
        Tocá la flecha para el siguiente
      </p>
    </div>

    <!-- Botón redondo de continuar en la esquina inferior derecha -->
    <button
      id="btn-siguiente"
      type="button"
      aria-label="Siguiente nombre"
      class="fixed bottom-6 right-6 z-10 flex h-16 w-16 items-center justify-center rounded-full border-[3px] border-ink bg-mustard font-display text-2xl font-black text-ink shadow-[4px_4px_0_var(--color-ink)] transition active:translate-x-[2px] active:translate-y-[2px] active:shadow-none"
      style="bottom: max(1.5rem, env(safe-area-inset-bottom)); right: max(1.5rem, env(safe-area-inset-right));"
    >
      →
    </button>
  </main>
</Layout>

